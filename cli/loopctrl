#!/usr/bin/env python3
"""loopctrl: send commands to a phone's LoopCtrl, over either connection method.

    loopctrl direct --host 100.64.0.7:8300 pair --name ops-laptop   # tailnet / LAN
    loopctrl direct --host 100.64.0.7:8300 call device_info
    loopctrl direct --host 100.64.0.7:8300 shot screen.jpg

    export LOOPCTRL_RELAY_URL=https://relay.example.com/loopctrl-relay
    export LOOPCTRL_RELAY_OPERATOR_TOKEN=...                       # never on argv
    loopctrl relay enroll --name "Alex"                            # invite link for the phone
    loopctrl relay devices
    loopctrl relay pair --device-id dev_...
    loopctrl relay call --device-id dev_... get_status '{}'

`direct` is cli/loopctrl_rpc.py (the phone's address must be reachable: the
same LAN, or a tailnet joined to your Headscale). `relay` is
connect/relay/relay_operator.py. Both keep their keys in ~/.loopctrl/.
"""
from __future__ import annotations

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
TOOLS = {
    "direct": os.path.join(HERE, "loopctrl_rpc.py"),
    "relay": os.path.join(HERE, "..", "connect", "relay", "relay_operator.py"),
}


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] not in TOOLS:
        print(__doc__.strip(), file=sys.stderr)
        return 0 if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help") else 2
    tool = os.path.normpath(TOOLS[sys.argv[1]])
    os.execv(sys.executable, [sys.executable, tool, *sys.argv[2:]])
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
