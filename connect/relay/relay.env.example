# Copy to relay.env (chmod 600). Never commit the real file.

# Bearer token for the operator and admin endpoints, at least 24 characters:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
LOOPCTRL_RELAY_OPERATOR_TOKEN=

# How phones reach this relay: host[:port][/path], no scheme. Enrollment
# signatures are bound to it, so it must match the public URL exactly.
#   relay.example.com            (relay on its own name)
#   example.com/loopctrl-relay   (relay under a path on an existing site)
LOOPCTRL_RELAY_PUBLIC_SERVER=

# Shown on the phone when it previews an invite.
LOOPCTRL_RELAY_ORGANIZATION=LoopCtrl Relay

# One line per enrollment / channel / RPC event (ids, sizes, timings; never
# tokens or bodies). 0 to turn off.
LOOPCTRL_RELAY_EVENT_LOG=1
